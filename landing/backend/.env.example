# Sales Orchestration Backend — Environment Variables

# Database
DATABASE_URL=sqlite:///./synth_sales_research.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/synth_sales

# Enable SQL query logging
SQL_ECHO=false

# Fetcher Configuration
FETCHER_MODE=stub
# Options: "stub" (default, no external API calls) or "newsapi+crunchbase"

# API Keys (required if FETCHER_MODE=newsapi+crunchbase)
NEWSAPI_KEY=
CRUNCHBASE_API_KEY=
APOLLO_API_KEY=

# Orchestration
MAX_CONCURRENCY=10
CACHE_TTL_SECONDS=86400
